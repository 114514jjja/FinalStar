:: FinalStar Settings [widget]
/* ============================================================
   终星 FinalStar —— 设置面板 / 内容速览 / 未来更新 / 游玩须知
   入口：侧边栏「模组设置」按钮（StoryCaption）、布告板里的入口
   （均不依赖框架）
   ============================================================ */

/* ===== 侧边栏按钮：白框 + 文字，和作弊按钮同一套样式 ===== */
<<widget "fs_sidebar_button">>
	<<if $fs_sidebarIcon isnot false>>
		<div class="fs_sidebar_row"><input type="button" class="saveMenuButton fs_sidebar_btn" value="模组设置" title="终星 · 模组设置（点开可开关各项功能）" onclick="finalStar.openSettings()"></div>
	<</if>>
<</widget>>

/* 这里原先有一个叫 fs_options_inline 的 widget（原版「选项」页内联设置区）。
   它从来没被调用过 —— 原设计靠 maplebirch 框架的 addto: Options 注入，
   但 boot.json 里既没有 maplebirch 的配置、也没把它列为依赖，游戏里 window.maplebirch 是 undefined。
   后果是「剧情战斗不救场」($fs_jiusiStoryGuard) 在游戏里根本没有勾选框。
   已把它唯一的独有内容（那个开关）并入 fs_panel_board（游玩须知 → 功能开关），
   其余 8 个开关本来就与 fs_panel_settings / fs_panel_board 重复。
   以后若要恢复「原版选项页」入口：用 TweeReplacer 补丁挂到 Options Overlay 里
   那些真正渲染的 widget（optionsgeneral / optionstheme / …）内部，别指望 maplebirch。
   注：本注释里故意不写宏的字面量 —— 尖括号形式会被 coderror 当成未闭合的宏报出来。 */

/* ===== 面板标题栏（页签导航） ===== */
<<widget "fs_title_panel">>
	<<setupTabs>>
	<div id="overlayTabs" class="tab">
		<<closeButtonMobile>>
		<<button "设置">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<fs_panel_settings>><</replace>>
		<</button>>
		<<button "内容速览">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<fs_panel_overview>><</replace>>
		<</button>>
		<<button "未来更新">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<fs_panel_future>><</replace>>
		<</button>>
		<<button "控制台">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<fs_panel_console>><</replace>>
		<</button>>
		<<button "游玩须知">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<fs_panel_notice>><</replace>>
		<</button>>
	</div>
	<<closeButton>>
<</widget>>

/* ===== 设置主面板 ===== */
<<widget "fs_panel_settings">>
	<<if V.fsData && V.fsData.jiusiDisappointed === 1>>
		<div class="fs-info-body fs_jiusi_status">
			<span class="red">玖肆对你感到失望。</span>（当前好感 <<print finalStar.jiusiLove()>>%）
			<br>
			<span class="fs-sub">她不再出现在孤儿院与学校；魔女小屋看起来也更破败了。解决掉你手上的奴隶，才有机会弥补。</span>
		</div>
		<br>
	<</if>>
	<<if V.fsData && finalStar.slaveCount && finalStar.slaveCount() gt 0>>
		<div class="fs-info-body">
			<span class="gold">你手下有 <<print finalStar.slaveCount()>> 名奴隶。</span>
			<br>
			<span class="fs-sub">每周欠款已永久增加 £<<print (V.fsData.pillRentAdded || 0)>>；周六可以在孤儿院大厅让 ta 们上缴。</span>
		</div>
		<br>
	<</if>>
	<div class="fs-panel">
		<h3><<icon "finalstar/medal-witness.png">> 终星 FinalStar <span class="fs-sub"><<print window.modSC2DataManager?.getModLoader()?.getModZip("FinalStar")?.modInfo?.version ?? "1.0.0">></span></h3>
		<div class="fs-sub">魔书魔法 · 魔法刻印 · 魔女小屋 · 地下洞穴 · 手枪重置</div>
		<br>
		<<if $fs_noCorpseDrag is undefined>><<set $fs_noCorpseDrag to false>><</if>>
		<<if $fs_freeCasino is undefined>><<set $fs_freeCasino to false>><</if>>
		<<if $fs_freeEncounter is undefined>><<set $fs_freeEncounter to false>><</if>>
		<<if $fs_casinoMaster is undefined>><<set $fs_casinoMaster to false>><</if>>
		<<if $fs_undying is undefined>><<set $fs_undying to false>><</if>>
		<<if $fs_alchemyMaster is undefined>><<set $fs_alchemyMaster to false>><</if>>
		<<if $fs_sidebarIcon is undefined>><<set $fs_sidebarIcon to true>><</if>>
		<<if $fs_combatPanel is undefined>><<set $fs_combatPanel to true>><</if>>

		/* 「功能开关」那一整块已按设计上搬走 —— 注意是搬进「游玩须知」页面里面
		   （由 fs_panel_notice 调用片段 widget fs_panel_board），不是新开一个页签。
		   用户澄清过这一点：「把布告板的内容挪到游玩须知里面」。
		   默认值那几行（判断开关是不是 undefined 再赋初值的那种）留在这里不动 ——
		   它们要在设置面板一打开就生效，不能跟着搬走，否则不开那一页就不会初始化。
		   注：这里故意不写出尖括号形式的宏，免得被 coderror 当成未闭合的宏。 */
		<div class="settingsHeader options">界面</div>
		<div class="fs-switch-grid">
			<div class="fs-switch-item">
				<<icon "finalstar/pistol-standard.png">>
				<label><<checkbox "$fs_combatPanel" false true autocheck>> 战斗中显示「手枪 / 魔书」物资面板</label>
				<mouse class="tooltip linkBlue">(?)<span>在战斗界面下方以折叠表格显示弹药余量、正在使用的子弹、魔书技能与今日吟唱次数。</span></mouse>
			</div>
			<div class="fs-switch-item">
				<<icon "finalstar/ui-settings.png">>
				<label><<checkbox "$fs_sidebarIcon" false true autocheck>> 侧边栏显示终星设置按钮</label>
			</div>
		</div>
		<br>
		/* 功能开关整块（片段 widget fs_panel_board）放设置页这里。
		   用户澄清过：「功能开关就是在设置里面」—— 之前跟着布告板内容一起被搬到了游玩须知，
		   那是我搬错了。布告板那些碎碎念留在游玩须知，开关回设置页。 */
		<<fs_panel_board>>
		<div class="fs-sub">提示：以上开关立即生效并随存档保存。</div>
	</div>
<</widget>>

/* ===== 内容速览 ===== */
<<widget "fs_panel_overview">>
	<div class="fs-panel">
		<h3><<icon "finalstar/ui-overview.png">> 内容速览</h3>
		<div class="fs-sub">以下是终星模组添加的全部内容与机制。</div>
		<br>
		<details class="journal" open>
			<summary class="journal"><<icon "finalstar/skill-assault.png">> 魔书魔法技能</summary>
			<div class="fs-info-body">
				持有魔书（主手或副手）时，战斗动作栏会出现三种魔法：
				<br>
				<span class="fs-tag">治疗术</span>：降低 <span class="gold">150</span> 点疼痛（装配炼金刻印时再多 <span class="gold">50</span>）。疼痛上限是 200，所以这一下能压下大半 —— 它占用的是每日 10 次吟唱里的一次，写"小幅"反而对不上数。
				<br>
				<span class="fs-tag">强攻术</span>：凝聚黑蛇扑向敌人，造成 <span class="gold">150</span> 点伤害。
				<br>
				<span class="fs-tag">荡魂术</span>：大幅削减敌人的怒气，让对方的攻势平息下来。
				<br>
				三种魔法共享每日吟唱次数，用尽后只能等第二天。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/seal-alchemy.png">> 魔法刻印与魔女小屋</summary>
			<div class="fs-info-body">
				麋鹿街开了一家「魔女小屋」，店主是名叫<span class="fs-celeste">西蕾丝提娅</span>的矮个女孩。
				<br>
				店内出售：<span class="fs-tag">魔法刻印</span>、<span class="fs-tag">魔法祝福卷轴</span>（临时 30 天 / 永久）、<span class="fs-tag">魔法小道具</span>（制式手枪、各类子弹、以及缓解感染与恢复理智的两瓶药）。
				<br>
				刻印共九枚：<span class="fs-tag">强攻</span> 1500 · <span class="fs-tag">先动</span> 2000 · <span class="fs-tag">反击</span> 500 · <span class="fs-tag">炼金</span> 2500 · <span class="fs-tag">血月</span> 3000 · <span class="fs-tag">回响</span> 3500 · <span class="fs-tag">静默</span> 2800 · <span class="fs-tag">毒牙</span> 3200 · <span class="fs-tag">星辉</span> 8000。
				<br>
				刻印可以装配到魔书上，装备后立即生效；被替换下来的刻印不会返还。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/cave-entrance.png">> 地下洞穴</summary>
			<div class="fs-info-body">
				森林湖泊处存在一处地下洞穴，共<span class="fs-tag">三层</span>，每层需要前进十次才能抵达下一层。
				<br>
				洞内的怪物不会试图与你性爱——它们只想杀死你。疼痛达到 <span class="gold">100</span> 时会立即结束遭遇战。
				<br>
				洞穴深处埋着与「终星」有关的秘密，以及一枚刻着「记忆会证明我们来过」的勋章。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/pistol-standard.png">> 手枪重置与子弹系统</summary>
			<div class="fs-info-body">
				手枪改为标准手持物，可在衣柜中装备与取下，战斗中通过下方物资面板切换弹药。
				<br>
				子弹从软弹到黑色雕纹弹共五种：普通子弹只能击退敌人（伤口会奇妙地愈合），
				只有<span class="fs-tag">雕纹子弹</span>才能真正杀死已命名角色。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/medal-witness.png">> 见证者与其它调整</summary>
			<div class="fs-info-body">
				<span class="fs-tag">见证者</span>特质：压力、疲劳、创伤、疼痛随时间自动降低。
				<br>
				贝利被枪杀后会在一段时间后回归，并加倍索取租金；银行新增代理缴费与存款利息；
				埋尸系统扩展至森林，并显示成功率；赌场新增高潮与昏倒事件。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/vial-cleanse.png">> 感染 · 饥饿 · 理智</summary>
			<div class="fs-info-body">
				三个数值都显示在左侧栏。下面写清各自怎么涨、怎么降、以及拖到最后会怎样。
				<br><br>
				<span class="fs-tag">感染</span>（0~100）
				<br>
				　增加：携带<span class="gold">制式手枪</span>时，每天 +5。
				<br>
				　减少：携带<span class="gold">魔法书</span>时，每小时 −1；<span class="gold">净化剂</span>（£70）一次 −15。
				<br>
				　到 <span class="gold">75</span> 以上：饥饿掉得更慢（每小时 +1），理智每天多回 1 点。
				<br>
				　到 <span class="gold">100</span>：触发「响尾蛇档案」，见下一条。
				<br><br>
				<span class="fs-tag">饥饿</span>（0~100，100 是吃饱）
				<br>
				　减少：每 <span class="gold">2 小时</span> −10（睡一觉起来会明显更饿）。
				<br>
				　恢复：吃东西。食堂一顿 +50，学校套餐 +45；随身食物按 土豆 15 / 蜂蜜 10 / 面包 20 /
				苹果 12 / 奶酪 18 / 熟肉 25 / 罐装食物 22 / 巧克力 15 / 水 3。
				<br>
				　后果①：饿着的时候压力涨得更快。低于 <span class="gold">50</span> 每过 1 小时压力 +1，
				低于 <span class="gold">25</span> +2，低于 <span class="gold">10</span> +4 —— 越饿越顶不住。
				<br>
				　后果②：掉到 <span class="gold">0</span> 会当场饿晕过去。再睁眼时，身边莫名其妙出现了三个面包。
				<br><br>
				<span class="fs-tag">理智</span>（0~100）
				<br>
				　恢复：每天 +2；<span class="gold">清明剂</span>（£100）一次 +20。
				<br>
				　　另有两条恢复途径（原先漏写在说明里）：
				理智低于 <span class="gold">50</span> 时，每天有 <span class="gold">25%</span> 概率有人从门缝下塞来信封，
				打开就是一瓶水与一片药（<span class="gold">理智 +30</span>，在卧室会看到提示）；
				以及在银行或赌场<span class="gold">昏倒</span>醒来时，理智补回 <span class="gold">50</span>（每天只算一次）。
				<br>
				　减少：战败（疼痛见底）时 −5。
				<br>
				　后果：归零会陷入<span class="red">混乱</span>——压力直接 +200；你自己的检定会被扣掉最多 <span class="gold">30</span> 个百分点（看到多少成功率，掷的就是多少），地点入口的文字也会糊成「？？？」。
				<br><br>
				两个药都在魔女小屋的「魔法小道具」页：<span class="gold">净化剂</span>（£70，感染 −15）、
				<span class="gold">清明剂</span>（£100，理智 +20）。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/snake-cross-icon.png">> 窥视真相 · 响尾蛇档案</summary>
			<div class="fs-info-body">
				感染满 <span class="gold">100</span> 时，时间会直接跳过七天，然后有一个存在隔着屏幕对你说话。
				<br>
				它会问你：要<span class="fs-tag">与堕落共沉沦</span>，还是<span class="fs-tag">为了别的而努力</span>。
				两个回答它都接受，只是回应不同。
				<br>
				随后响尾蛇档案自动记录你的名字，你获得人物特质<span class="red">窥视真相</span>：
				<br>
				　收益：遭遇战中受到的<span class="gold">疼痛减少 25%</span>。
				<br>
				　代价：每晚 <span class="gold">23:00</span> 会感到被偷窥，压力 +40。
				<br><br>
				「窥视真相」可以在特质页看到，与「见证者」并列。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/lab-door.png">> 排水系统尽头的实验室</summary>
			<div class="fs-info-body">
				玖肆好感达到 <span class="gold">50%</span> 时，与她在孤儿院聊天会拿到一把钥匙。
				<br>
				原版「下水道」菜单里会多出第三个选项<span class="fs-tag">「？？？」</span>（开过一次后变成「推开暗门」）。
				<br>
				里面是一间简陋的实验室：散落一地的实验材料、一个能钻进去的纸箱、一堆还能用的器材。
				纸箱可以睡、时长自己选，但<span class="red">第三次</span>玖肆会告诉你「这里似乎被盯上了」，之后就不能再睡了。
				<br>
				摆弄器材会发现一本硬皮本子——幻界任务清单、被撕掉与涂黑的页，最后一页写着「x计划」。
			</div>
		</details>
		<details class="journal">
			<summary class="journal"><<icon "finalstar/morans-fog.png">> 长线剧情「莫伦斯」</summary>
			<div class="fs-info-body">
				实验室开启后<span class="gold">第 3 天</span>再去，会撞见玖肆在修一枚银镶蓝宝石的戒指；
				谈完可以选<span class="fs-tag">双人</span>或<span class="fs-tag">单人</span>（各拿 6 发银弹）。
				<br>
				<span class="gold">十天之后</span>，宅邸街会出现「走进灰色迷雾」——文本很长，建议先存档；到日子后会一直存在。
				<br>
				城市里的时间<span class="fs-tag">独立计数</span>，不影响现实时间。整座城是「田」字九格：
				<span class="fs-tag">中央大厦</span>、西侧步行街（速食／甜品／服装／杂货／旅店）、西北公园、
				北边学校、东北高档小区、东边政府大厦、南边住宅区，另有<span class="gold">西南便利商店</span>、
				<span class="gold">东南诊所</span>与四条<span class="gold">马路</span>（站上去必定遇到街头事件）。
				地图就在段落下方，可以直接点着走。另有第 5 天的世界异变、时间遥变迷图，以及与笙不瑜的对峙。
				<br>
				对峙时有三个方向：<span class="fs-tag">A · 兵将疾行</span>（回头 / 拒绝）、
				<span class="gold">B · 爱</span>（苏梦棠好感 ≥70% 拿到纪念币，对峙时「掏出那枚硬币」）、
				<span class="red">C · 崩坏</span>（步行街杂货店买巫毒娃娃，对峙时「拿出那个巫毒娃娃」→ 玖肆死亡）。
				<br>
				控制台第 12 个分区「◆ 莫伦斯」可以看进度、提前解锁结局、让她回来。
			</div>
		</details>
	</div>
<</widget>>

/* ===== 未来更新 ===== */
<<widget "fs_panel_future">>
	<div class="fs-panel">
		<h3><<icon "finalstar/ui-future.png">> 未来更新</h3>

		<div class="fs-info-body">
			<span class="fs-tag">v0.28 · 正式版</span>
			<br>
			① <span class="gold">走路终于会饿了</span>：以前只有触发事件才掉饥饿，走路一整天不掉。根因是每小时都在推进时间戳、却要求"跨满 2 小时"才扣，小数小时被永久丢弃。现在改成零头累加。
			<br>
			② <span class="gold">饥饿后果重做</span>：撤掉"低于 50 拖慢行动"，改为<span class="gold">越低压力涨得越快</span>（低于 50 每小时 +1、低于 25 +2、低于 10 +4）；饥饿掉到 0 会当场<span class="red">饿晕</span>，醒来时身边莫名多出<span class="gold">三个面包</span>。
			<br>
			③ <span class="gold">埋尸误触发修复（本次最严重）</span>：以前<b>每一场打赢的架</b>都会把你拖进"你杀了人、去埋尸"。原因是被当成了"敌人血量 ≤ 0 = 你杀死了对方"——而原版自己就是用血量归零表示软模式下说服对方走开的。现在只有真的用致命子弹打死人才进埋尸。
			<br>
			④ <span class="gold">开枪结果终于显示</span>：此前每次射击都会因一个未声明的变量抛异常并被静默吞掉 —— 扣弹扣血照常，但「弹仓 X 发 · 本次伤害 X 点」永远不显示。
			<br>
			⑤ <span class="gold">修复若干"根本不存在的数据字段"</span>：疼痛上限、周期时间戳、护理技能、疲劳上限此前读写的都是原版没有的字段，导致<span class="red">战败 −5 理智从未触发过</span>、奴隶上缴一生只能领一次、埋尸伪装率恒 0%、疲劳永远不触发晕倒。现已全部改用原版真实字段，旧存档会自动迁移。
			<br>
			⑥ <span class="gold">银行通知恢复</span>：利息入账与代理缴款（含失败）的通知此前写在一个没有任何入口的旧段落里 —— 钱被划走却没有提示。现在进银行大厅时职员会当面告知。
			<br>
			⑦ <span class="gold">其它修复</span>：洞穴遭遇战里「继续」不再被送去卧室；「杀人不埋尸」开关在枪杀路径上也生效；保举名额现在真的扣 £2000；代理缴费不再一周扣两次；低理智下难度提示只降一档（以前"简单"会被改写成"不可能"）；进食不再因为重绘而重复加饥饿。
			<br><br>
			<span class="fs-tag">上次更新（0.27）</span>
			<br>
			① <span class="gold">魔法刻印扩充</span>：新增血月 / 回响 / 静默 / 毒牙 / 星辉五枚，魔女小屋已上架；刻印触发时会在正文显示金色流光的提示。
			<br>
			② <span class="gold">炼金大能</span>：设置里新增开关，开启后炼金刻印必定触发 —— 收到钱必定<span class="gold">双倍</span>，花钱必定<span class="gold">免单</span>。
			<br>
			③ <span class="gold">侧边栏</span>：「模组设置」移到「存档」下方独占一行，并做了荆棘藤纹与星辰的边框。
			<br>
			④ <span class="gold">人格洗脑丸</span>：<s class="grey">赌场三楼办公室已开放购买（两条线各有门路），可以下在食物里、也可以直接塞进对方嘴里。</s>
			<br>
			⑤ <span class="gold">修复</span>：作弊面板里疼痛数值消失、报错的问题（同时会自动修复已损坏的存档数值）；银行与赌场不再被判定为室外淋雨；赌场的高潮与昏倒事件现在能正常触发。
		</div>

		<br>
		<div class="fs-sub">以下是终星的后续计划。</div>
		<br>
		<div class="fs-info-body">
			<span class="fs-tag">1.</span> 城镇中更多的遭遇战。<br>
			<span class="fs-tag">2.</span> 更多专属于天使与恶魔的故事。<br>
			<span class="fs-tag">3.</span> 两条主线（玖肆线 / 贝利线）的新内容。<br>
			<span class="fs-tag">4.</span> 第一个长篇故事。<br>
			<span class="fs-tag">5.</span> 修复已知问题。<br>
			<span class="fs-tag">6.</span> <s class="grey">人格洗脑丸<span class="fs-sub">（已完成 · 见上方 0.27 更新）</span></s>
			<br>
			<span class="fs-sub">
				一枚会在肠胃里化开的小药片。它不杀人，它<span class="gold">拆人</span>——从心理到生理，把一个人的意志一层层剥下来，
				直到对方只剩下听话这一件事还做得像样。<br>
				它最主要的用法并不是塞进谁嘴里，而是<span class="gold">混进吃的里面</span>：一口面包、一杯水，比任何强迫都有效。<br>
				遇到麻烦时也可以直接塞进对方嘴里——只要对方肯张嘴。咽下去之后，那场冲突会自己结束，
				而 ta 会从事实上成为你的奴隶：你可以在孤儿院大厅找到 ta，命令 ta 干活、解决你的欲望，或者让 ta 自己走开再也不回来。<br>
				<span class="red">这玩意儿没法后悔。</span>买到手就是买到手了，用掉就是用掉了，而且一次最多只卖你<span class="gold">两颗</span>。<br>
				另外，对拥有<span class="gold">异常力量</span>的人——天使、恶魔、以及那些身上缠着别的东西的家伙——它<span class="red">几乎没有效果</span>。<br>
				想要买到它，得先想办法进赌场三楼的办公室。至于怎么进去，老板只跟"自己人"谈生意。
			</span>
		</div>
	</div>
<</widget>>


