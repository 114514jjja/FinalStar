<<if C.npc.Whitney.init is 1 and C.npc.Whitney.state isnot "dead">><<set _npcPool.push("Whitney")>><</if>>
<<if C.npc.Kylar.init is 1 and C.npc.Kylar.state isnot "dead">><<set _npcPool.push("Kylar")>><</if>>
